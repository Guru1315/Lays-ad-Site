{
  "name": "crunch-lab-api",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker + D1 backend for the Crunch Lab site (Join sign-ups and Build-a-Box orders).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply crunch-lab --local",
    "db:migrate:remote": "wrangler d1 migrations apply crunch-lab --remote",
    "keys": "node scripts/generate-keys.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm audit --audit-level=moderate",
    "order:status": "node scripts/set-order-status.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.9.0",
    "@cloudflare/workers-types": "5.20261123.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.166.0"
  },
  "dependencies": {
    "@simplewebauthn/server": "14.1.0",
    "zod": "4.6.7"
  },
  "allowScripts": {
    "workerd@1.20261119.1": true,
    "esbuild@0.28.2": true
  }
}
